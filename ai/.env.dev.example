# LLM Provider (Shared Dev OpenAI / Azure OpenAI account)
LLM_API_KEY=your-dev-openai-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
AI_HTTP_PORT=8000

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# PostgreSQL (pgvector - Dev Server)
POSTGRES_HOST=postgres-dev.internal
POSTGRES_PORT=5432
POSTGRES_DB=support_platform_dev
POSTGRES_USER=support_app_dev
POSTGRES_PASSWORD=your-dev-db-password
POSTGRES_RAG_TABLE=document_chunks

# RAG Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
RAG_TOP_K=4
CHROMA_PERSIST_DIR=/app/data/chroma
