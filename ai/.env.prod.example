# LLM Provider (Production Enterprise OpenAI / Bedrock / Azure endpoint)
LLM_API_KEY=your-production-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
AI_HTTP_PORT=8000

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# PostgreSQL (pgvector - Production High Availability Cluster)
POSTGRES_HOST=postgres-primary.prod.internal
POSTGRES_PORT=5432
POSTGRES_DB=support_platform_prod
POSTGRES_USER=support_app_prod
POSTGRES_PASSWORD=your-secure-production-db-password
POSTGRES_RAG_TABLE=document_chunks

# RAG Defaults (Production Precision)
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
RAG_TOP_K=6
CHROMA_PERSIST_DIR=/var/data/chroma
