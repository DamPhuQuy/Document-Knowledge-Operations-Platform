// ============================================================================
// ENTERPRISE DOCUMENT KNOWLEDGE & OPERATIONS PLATFORM
// ULTRA-LEAN MVP DATABASE SCHEMA (POSTGRESQL 16)
// ============================================================================
// Source of Truth: docs/specs/business/ (MVP.md, 01_problem_and_business_scope.md,
//                  03_use_case_architecture.md, 05_requirements_traceability_matrix.md)
//
// Core Bounded Contexts in Ultra-Lean MVP Scope:
// 1. Identity & Access Management (BC 1: IAM_Organization) - UC-IAM-01..03
// 2. Document Management & S3 Storage (BC 2: Document_Management) - UC-DOC-01..04
// 3. Audit Subsystem (BC 3: Audit_System) - UC-AUDIT-01
//
// Deferred Components (Moved to docs/specs/business/deferred/ for Phase 2):
// - AI Knowledge & Hybrid RAG (document_chunks, pgvector, HNSW)
// - Conversational AI (conversations, conversation_messages, message_citations)
// - Workflow Automation (workflows, workflow_executions)
// - Operations & HITL Approvals (action_approvals, operation_tasks)
// - Real-time Push Notifications (notifications)
// ============================================================================

Project document_knowledge_operations_platform {
  database_type: 'PostgreSQL 16'
  Note: '''
    # Enterprise Document Knowledge & Operations Platform - Ultra-Lean MVP Database Schema
    
    ## Architectural Context & MVP Scope
    This database schema models the 3 Core Bounded Contexts of the Ultra-Lean MVP:
    1. **IAM & Organization (BC 1)**: Multi-tenant organizational scoping, multi-role RBAC, and session management (UC-IAM-01..03).
    2. **Document Management & Storage (BC 2)**: AWS S3-integrated document catalog, immutable version snapshots, and 4-tier ACL matrix (UC-DOC-01..04).
    3. **Audit Subsystem (BC 3)**: Append-only, tamper-evident compliance audit trail (UC-AUDIT-01).
    
    All non-essential and heavy application components (AI/RAG, Conversational Chat, Workflow Automation Engines,
    2-Phase HITL Approvals, and Real-Time Push Notifications) have been deferred to Phase 2 to ensure the fastest
    path to production on AWS Cloud infrastructure.
  '''
}

// ============================================================================
// ENUMERATIONS
// ============================================================================

enum document_status {
  UPLOADED    [note: 'Binary successfully stored in AWS S3 and ready for processing']
  PROCESSING  [note: 'Document is undergoing parsing, chunking, or indexing']
  READY       [note: 'Document is processed and ready for search and knowledge retrieval']
  FAILED      [note: 'Processing pipeline encountered an unrecoverable error']
}

enum access_level {
  PUBLIC        [note: 'Accessible to all authenticated internal users']
  INTERNAL      [note: 'Accessible within the owning department or granted units']
  RESTRICTED    [note: 'Requires explicit user, department, or role ACL grant']
  CONFIDENTIAL  [note: 'Strictly limited to designated executive or compliance roles']
}

enum permission_level {
  VIEW   [note: 'Read-only access to metadata and binary download via presigned URL']
  EDIT   [note: 'Permission to update metadata, upload new versions, and configure access']
  ADMIN  [note: 'Full administrative control including ACL management and soft deletion']
}

enum audit_status {
  SUCCESS  [note: 'Operation completed successfully']
  FAILED   [note: 'Operation failed, unauthorized, or rejected by invariants']
}

// ============================================================================
// BOUNDED CONTEXT 1: IDENTITY & ACCESS MANAGEMENT (IAM) & ORGANIZATION
// ============================================================================

Table departments {
  id uuid [pk, note: 'UUIDv7 primary key']
  code varchar(50) [unique, not null, note: 'Unique business identifier: e.g. FIN, HR, IT, LEGAL']
  name varchar(255) [not null, note: 'Full department name']
  description text [note: 'Business charter and operational scope']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    code
  }

  Note: 'BC 1 Core Table: Defines organizational departments for tenancy and access isolation (UC-IAM-03).'
}

Table users {
  id uuid [pk, note: 'UUIDv7 primary key']
  email varchar(255) [unique, not null, note: 'Corporate email address used for login']
  password_hash varchar(255) [not null, note: 'BCrypt encrypted password hash (work factor >= 12)']
  full_name varchar(255) [not null, note: 'Full display name of employee/contractor']
  department_id uuid [ref: > departments.id, note: 'Primary assigned department']
  enabled boolean [not null, default: true, note: 'Account status flag; false disables login']
  is_internal boolean [not null, default: true, note: 'Internal enterprise staff vs external contractor']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    email
    department_id
  }

  Note: 'BC 1 Core Table: Authenticated user accounts and organizational association (UC-IAM-01, UC-IAM-03).'
}

Table roles {
  id uuid [pk, note: 'UUIDv7 primary key']
  code varchar(50) [unique, not null, note: 'Standard role identifier: ROLE_ADMIN, ROLE_MANAGER, ROLE_STAFF, ROLE_LEGAL_AUDITOR, ROLE_CUSTOMER']
  name varchar(100) [not null, note: 'Human-readable role name']
  description text [note: 'Summary of privileges granted by this role']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    code
  }

  Note: 'BC 1 Core Table: System and domain roles defining permission boundaries (UC-IAM-02).'
}

Table permissions {
  id uuid [pk, note: 'UUIDv7 primary key']
  code varchar(100) [unique, not null, note: 'Granular authority code: read:documents, write:documents, delete:documents, manage:permissions, manage:users, read:audit_logs']
  name varchar(150) [not null, note: 'Human-readable permission title']
  module varchar(50) [not null, note: 'Functional bounded context: IAM, DMS, AUDIT']
  description text [note: 'Functional specification of the authority']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    code
    module
  }

  Note: 'BC 1 Core Table: Granular functional authorities mapped into Spring Security (UC-IAM-02).'
}

Table user_roles {
  user_id uuid [ref: > users.id, not null]
  role_id uuid [ref: > roles.id, not null]
  assigned_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, role_id) [pk]
    role_id
  }

  Note: 'BC 1 Core Junction: Many-to-many assignment of roles to user accounts (UC-IAM-02).'
}

Table role_permissions {
  role_id uuid [ref: > roles.id, not null]
  permission_id uuid [ref: > permissions.id, not null]
  granted_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (role_id, permission_id) [pk]
    permission_id
  }

  Note: 'BC 1 Core Junction: Many-to-many mapping of permissions to roles (UC-IAM-02).'
}

Table refresh_tokens {
  id uuid [pk, note: 'UUIDv7 primary key']
  user_id uuid [ref: > users.id, not null, note: 'Owning user account']
  token varchar(512) [unique, not null, note: 'Opaque cryptographically secure refresh token string']
  expiry_date timestamptz [not null, note: 'Token expiration instant (e.g. 7-30 days from issue)']
  revoked boolean [not null, default: false, note: 'Explicit revocation flag for logout or security breach']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    user_id
    token
  }

  Note: 'BC 1 Core Table: Long-lived session management for secure JWT renewal (UC-IAM-01).'
}

// ============================================================================
// BOUNDED CONTEXT 2: DOCUMENT MANAGEMENT SYSTEM (DMS) & AWS S3 STORAGE
// ============================================================================

Table documents {
  id uuid [pk, note: 'Globally unique document identifier (UUIDv7)']
  title varchar(255) [not null, note: 'Business title displayed in UI']
  original_file_name varchar(255) [not null, note: 'Original uploaded filename with extension']
  content_type varchar(100) [not null, note: 'Verified MIME type: application/pdf, application/vnd.openxmlformats..., text/plain']
  file_size_bytes bigint [not null, note: 'Exact binary size in bytes (max 50MB in MVP)']
  checksum_sha256 varchar(64) [not null, note: 'Cryptographic SHA-256 hash for deduplication and tampering detection']
  storage_key varchar(512) [not null, note: 'S3 Object Key path: documents/{doc_id}/{filename}']
  current_version int [not null, default: 1, note: 'Current active revision version number (1-based)']
  status document_status [not null, default: 'UPLOADED', note: 'Processing state: UPLOADED, PROCESSING, READY, FAILED']
  uploaded_by_user_id uuid [ref: > users.id, not null, note: 'User who created the document record']
  department_id uuid [ref: > departments.id, note: 'Primary department owner for tenancy boundaries']
  access_level access_level [not null, default: 'INTERNAL', note: 'Security classification: PUBLIC, INTERNAL, RESTRICTED, CONFIDENTIAL']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    status
    uploaded_by_user_id
    department_id
    (department_id, status)
    checksum_sha256
  }

  Note: 'BC 2 Core Table: Master catalog for enterprise documents persisted durably in AWS S3 (UC-DOC-01, UC-DOC-03, UC-DOC-04).'
}

Table document_versions {
  id uuid [pk, note: 'UUIDv7 primary key']
  document_id uuid [ref: > documents.id, not null, note: 'Parent document reference']
  version_number int [not null, note: 'Sequential version number (1, 2, 3...)']
  storage_key varchar(512) [not null, note: 'Exact AWS S3 object key for this version']
  file_size_bytes bigint [not null, note: 'Binary size of this specific version in bytes']
  checksum_sha256 varchar(64) [not null, note: 'SHA-256 hash of this specific version binary']
  change_summary varchar(500) [note: 'Description of changes introduced in this version']
  uploaded_by_user_id uuid [ref: > users.id, not null, note: 'User who uploaded this specific version']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (document_id, version_number) [unique]
    uploaded_by_user_id
  }

  Note: 'BC 2 Core Table: Immutable historical snapshots of document binaries stored on AWS S3 (UC-DOC-02).'
}

Table document_user_access {
  id uuid [pk, note: 'UUIDv7 primary key']
  document_id uuid [ref: > documents.id, not null, note: 'Target document']
  user_id uuid [ref: > users.id, not null, note: 'Granted individual user']
  permission_level permission_level [not null, default: 'VIEW', note: 'VIEW, EDIT, or ADMIN']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (document_id, user_id) [unique]
    user_id
  }

  Note: 'BC 2 Core Table: Explicit user-level Access Control List (ACL) (UC-DOC-03).'
}

Table document_department_access {
  id uuid [pk, note: 'UUIDv7 primary key']
  document_id uuid [ref: > documents.id, not null, note: 'Target document']
  department_id uuid [ref: > departments.id, not null, note: 'Granted department']
  permission_level permission_level [not null, default: 'VIEW', note: 'VIEW, EDIT, or ADMIN']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (document_id, department_id) [unique]
    department_id
  }

  Note: 'BC 2 Core Table: Cross-departmental sharing Access Control List (ACL) (UC-DOC-03).'
}

Table document_role_access {
  id uuid [pk, note: 'UUIDv7 primary key']
  document_id uuid [ref: > documents.id, not null, note: 'Target document']
  role_id uuid [ref: > roles.id, not null, note: 'Granted role']
  permission_level permission_level [not null, default: 'VIEW', note: 'VIEW, EDIT, or ADMIN']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (document_id, role_id) [unique]
    role_id
  }

  Note: 'BC 2 Core Table: Role-based document Access Control List (ACL) (UC-DOC-03).'
}

// ============================================================================
// BOUNDED CONTEXT 3: AUDIT SUBSYSTEM (APPEND-ONLY AUDIT TRAIL)
// ============================================================================

Table audit_logs {
  id uuid [pk, note: 'UUIDv7 primary key']
  user_id uuid [ref: > users.id, note: 'Acting user ID (NULL for unauthenticated or system daemon events)']
  action varchar(100) [not null, note: 'Action verb: LOGIN, LOGIN_FAILED, LOGOUT, REFRESH_TOKEN, UPLOAD_DOC, UPDATE_DOC, UPDATE_ACL, DELETE_DOC, ASSIGN_ROLES, etc.']
  resource_type varchar(100) [not null, note: 'Target resource domain: DOCUMENT, USER, DEPARTMENT, ROLE, S3_OBJECT, AUTH']
  resource_id varchar(64) [note: 'Target resource primary key or S3 key']
  ip_address varchar(45) [note: 'Client IPv4/IPv6 address captured at edge ingress']
  user_agent text [note: 'Client User-Agent header for forensic audit']
  status audit_status [not null, default: 'SUCCESS', note: 'Outcome: SUCCESS or FAILED']
  details jsonb [not null, default: `'{}'`, note: 'Immutable contextual payload: diffs, error messages, request parameters']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`, note: 'Immutable event timestamp; no updates or deletes permitted']

  indexes {
    user_id
    (resource_type, resource_id)
    created_at
    (user_id, created_at)
  }

  Note: 'BC 3 Core Table: Append-only tamper-evident compliance audit log (UC-AUDIT-01).'
}

// ============================================================================
// BOUNDED CONTEXT TABLE GROUPS
// ============================================================================

TableGroup MVP_IAM_Organization {
  departments
  users
  roles
  permissions
  user_roles
  role_permissions
  refresh_tokens
}

TableGroup MVP_Document_Management {
  documents
  document_versions
  document_user_access
  document_department_access
  document_role_access
}

TableGroup MVP_Audit_System {
  audit_logs
}
