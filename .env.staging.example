# ==============================================================================
# Staging / Pre-Production Environment (.env.staging)
# Usage: cp .env.staging.example .env.staging
# Run:   make staging
# ==============================================================================

COMPOSE_PROJECT_NAME=doc_knowledge_staging

# 1. Database (Staging PostgreSQL Cluster / Aurora)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=doc_knowledge_staging
POSTGRES_USER=doc_knowledge_staging_user
POSTGRES_PASSWORD=replace-with-secure-staging-password
POSTGRES_RAG_TABLE=document_chunks

# 2. Backend Service (Spring Boot 4 - Staging Profile)
BACKEND_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=staging
JWT_SECRET=replace-with-staging-jwt-secret-min-256-bits-long-random-string
JWT_EXPIRATION_MS=14400000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=https://staging.docknowledge.company.com,http://localhost:3000
LIQUIBASE_ENABLED=true
JPA_SHOW_SQL=false
SWAGGER_ENABLED=true

# 3. Frontend Web Client (Production Build with Staging Environment Settings)
FRONTEND_PORT=3000
VITE_API_BASE_URL=https://staging-api.docknowledge.company.com/api/v1
VITE_APP_TITLE=Document & Knowledge Operations Platform (Staging)
VITE_APP_ENV=staging
VITE_ENABLE_DEBUG=true
APP_VERSION=1.0.0-rc

# 4. AI & Hybrid RAG Microservice (Staging Instance)
AI_PORT=8000
AI_HTTP_PORT=8000
AI_SERVICE_URL=http://ai:8000
LLM_API_KEY=replace-with-staging-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
RAG_TOP_K=4

# 5. Object Storage (AWS S3 Staging)
AWS_S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_S3_BUCKET=doc-knowledge-storage-staging
AWS_ACCESS_KEY_ID=replace-with-staging-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-staging-aws-secret-access-key
AWS_S3_PATH_STYLE_ACCESS=false

# 6. Performance & Concurrency
SPRING_THREADS_VIRTUAL_ENABLED=true

# 7. Email / SMTP Notification Service
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=replace-with-staging-smtp-password-or-api-key
SMTP_FROM=noreply-staging@docknowledge.company.com
SMTP_AUTH=true
SMTP_STARTTLS=true

