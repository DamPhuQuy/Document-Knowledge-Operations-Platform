# ==============================================================================
# Production Environment (.env.prod)
# Usage: cp .env.prod.example .env.prod
# Run:   make prod
# ==============================================================================

COMPOSE_PROJECT_NAME=doc_knowledge_prod

# 1. Database (Production Managed RDS/Aurora or Protected Docker DB)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=doc_knowledge_prod
POSTGRES_USER=doc_app_prod_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_STRONG_PASSWORD_HERE
POSTGRES_RAG_TABLE=document_chunks

# 2. Backend Service (Spring Boot 4 - Production Profile, Non-Root)
BACKEND_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=CHANGE_ME_PRODUCTION_HIGH_ENTROPY_JWT_SECRET_MIN_512_BITS_LONG
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=https://docknowledge.company.com
LIQUIBASE_ENABLED=true
JPA_SHOW_SQL=false
SWAGGER_ENABLED=false

# 3. Frontend Web Client (Hardened Nginx Alpine Static Server)
FRONTEND_PORT=80
VITE_API_BASE_URL=https://api.docknowledge.company.com/api/v1
VITE_APP_TITLE=Document & Knowledge Operations Platform
VITE_APP_ENV=production
VITE_ENABLE_DEBUG=false
APP_VERSION=1.0.0

# 4. AI & Hybrid RAG Microservice (Production Endpoint, Non-Root)
AI_PORT=8000
AI_HTTP_PORT=8000
AI_SERVICE_URL=http://ai:8000
LLM_API_KEY=CHANGE_ME_PRODUCTION_OPENAI_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
RAG_TOP_K=4

# 5. Object Storage (AWS S3 Cloud Production)
AWS_S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_S3_BUCKET=doc-knowledge-storage-prod
AWS_ACCESS_KEY_ID=CHANGE_ME_PRODUCTION_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_PRODUCTION_AWS_SECRET_ACCESS_KEY
AWS_S3_PATH_STYLE_ACCESS=false

# 6. Performance & Concurrency
SPRING_THREADS_VIRTUAL_ENABLED=true
