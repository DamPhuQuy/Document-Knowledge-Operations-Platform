# Database (Production Aurora/RDS PostgreSQL Cluster)
POSTGRES_USER=support_app_prod
POSTGRES_PASSWORD=your-secure-production-db-password
POSTGRES_DB=support_platform_prod
POSTGRES_PORT=5432

# Backend (Spring Boot - Production)
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=your-production-high-entropy-jwt-secret-min-512-bits-long
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=https://support.company.com

# Frontend (Production)
FRONTEND_PORT=3000
VITE_API_BASE_URL=https://api.support.company.com/api/v1

# AI Service (Production)
AI_PORT=8000
AI_SERVICE_URL=http://ai-service.prod.internal:8000
