# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# Stage 1: Build Static Production Assets (Node 22 Alpine)
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package.json package-lock.json ./
RUN npm ci

# Accept environment build arguments
ARG VITE_API_BASE_URL
ARG VITE_APP_TITLE
ARG VITE_APP_ENV=production
ARG VITE_ENABLE_DEBUG=false
ARG VITE_APP_VERSION=1.0.0

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_APP_TITLE=${VITE_APP_TITLE} \
    VITE_APP_ENV=${VITE_APP_ENV} \
    VITE_ENABLE_DEBUG=${VITE_ENABLE_DEBUG} \
    VITE_APP_VERSION=${VITE_APP_VERSION} \
    NODE_ENV=production

# Copy source code and build production bundle
COPY . ./
RUN npm run build:prod

# ------------------------------------------------------------------------------
# Stage 2: Hardened Minimal Static Asset Serving (Nginx Alpine)
# ------------------------------------------------------------------------------
FROM nginx:alpine

WORKDIR /usr/share/nginx/html

# Install curl for container health check
RUN apk add --no-cache curl

# Remove default assets and configuration
RUN rm -rf ./* /etc/nginx/conf.d/default.conf

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist ./

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
