# ==============================================================================
# Document & Knowledge Operations Platform - Local / Dev Environment Template
# Standard: Twelve-Factor App (Factor III: Store config in the environment)
# Usage:    cp .env.example .env
# Run:      make dev / make dev-watch
# ==============================================================================

COMPOSE_PROJECT_NAME=doc_knowledge_example

# 1. Database (Local PostgreSQL 16 with pgvector extension)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=doc_knowledge_example_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
POSTGRES_RAG_TABLE=example_chunks

# 2. Backend Service (Spring Boot 4, Java 25 - Dev Profile)
BACKEND_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=example_secret_key_change_me_to_at_least_64_characters_long_12345
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
LIQUIBASE_ENABLED=true
JPA_SHOW_SQL=false
SWAGGER_ENABLED=false

# 3. Frontend Web Client (React 19, TypeScript, Vite Dev Server)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_TITLE=Document & Knowledge Platform (Example)
VITE_APP_ENV=development
VITE_ENABLE_DEBUG=false
APP_VERSION=1.0.0-example

# 4. AI & Hybrid RAG Microservice (Python 3.11+, FastAPI, pgvector)
AI_PORT=8000
AI_HTTP_PORT=8000
AI_SERVICE_URL=http://ai:8000
LLM_API_KEY=your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
RAG_TOP_K=4

# 5. Object Storage (Floci S3 Emulator for Dev)
FLOCI_PORT=4566
AWS_S3_ENDPOINT=http://floci:4566
AWS_REGION=us-east-1
AWS_S3_BUCKET=example-bucket
AWS_ACCESS_KEY_ID=example_access_key
AWS_SECRET_ACCESS_KEY=example_secret_key
AWS_S3_PATH_STYLE_ACCESS=true

# 6. Performance & Concurrency
SPRING_THREADS_VIRTUAL_ENABLED=false

# 7. Email / SMTP Notification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password-or-app-password
SMTP_FROM=noreply@docops.internal
SMTP_AUTH=true
SMTP_STARTTLS=true

