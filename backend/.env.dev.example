# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL - Staging/Dev Cluster)
DB_HOST=postgres-dev.internal
DB_PORT=5432
DB_NAME=support_platform_dev
DB_USERNAME=support_app_dev
DB_PASSWORD=your-dev-db-password
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20

# Docker Compose Database (Optional for dev)
POSTGRES_USER=support_app_dev
POSTGRES_PASSWORD=your-dev-db-password
POSTGRES_DB=support_platform_dev
POSTGRES_PORT=5432

# Liquibase
LIQUIBASE_ENABLED=true
LIQUIBASE_DROP_FIRST=false

# JPA / Hibernate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_HIBERNATE_DDL_AUTO=validate

# JWT Security
JWT_SECRET=your-dev-environment-jwt-secret-min-256-bits-long
JWT_EXPIRATION_MS=43200000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=https://dev.support.company.com,http://localhost:3000,http://localhost:5173

# AI Service (Dev Microservice)
AI_SERVICE_URL=http://ai-service-dev:8000
AI_GENERATE_PATH=/api/v1/ai/generate
LLM_TIMEOUT=15s

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_TITLE=Customer Support Platform API (Dev)
SWAGGER_DESCRIPTION=RESTful API documentation for Customer Support Platform
SWAGGER_VERSION=1.0.0
