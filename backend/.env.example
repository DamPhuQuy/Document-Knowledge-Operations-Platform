# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=doc_knowledge_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20

# Docker Compose Database (backend/docker-compose.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_knowledge_db
POSTGRES_PORT=5432

# Liquibase
LIQUIBASE_ENABLED=true
LIQUIBASE_DROP_FIRST=false

# JPA / Hibernate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_HIBERNATE_DDL_AUTO=validate

# JWT Security (min 256-bit secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_GENERATE_PATH=/api/v1/ai/generate
LLM_TIMEOUT=10s

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_TITLE=Document and Knowledge Operations Platform API
SWAGGER_DESCRIPTION=RESTful API documentation for Document and Knowledge Operations Platform
SWAGGER_VERSION=1.0.0
