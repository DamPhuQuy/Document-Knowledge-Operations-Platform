# ==============================================================================
# Application Environment Variables
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/
SPRING_PROFILES_ACTIVE=local

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=support_platform_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20

# Docker Compose Settings (used by docker-compose.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=support_platform_db
POSTGRES_PORT=5432

# Liquibase Migration Settings
LIQUIBASE_ENABLED=true
LIQUIBASE_DROP_FIRST=false

# JPA / Hibernate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_HIBERNATE_DDL_AUTO=validate

# JWT Security Configuration
# JWT_SECRET must be at least 256-bit (32+ characters) hex/base64 or string
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# OpenAPI / Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_TITLE=Customer Support Platform API
SWAGGER_DESCRIPTION=RESTful API documentation for Customer Support Platform
SWAGGER_VERSION=1.0.0
