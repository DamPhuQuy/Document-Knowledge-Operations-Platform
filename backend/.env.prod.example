# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database (PostgreSQL - Production Aurora/RDS Cluster)
DB_HOST=postgres-primary.prod.internal
DB_PORT=5432
DB_NAME=support_platform_prod
DB_USERNAME=support_app_prod
DB_PASSWORD=your-secure-production-db-password
DB_POOL_MIN_IDLE=10
DB_POOL_MAX_SIZE=50

# Docker Compose Database (Production credentials)
POSTGRES_USER=support_app_prod
POSTGRES_PASSWORD=your-secure-production-db-password
POSTGRES_DB=support_platform_prod
POSTGRES_PORT=5432

# Liquibase
LIQUIBASE_ENABLED=true
LIQUIBASE_DROP_FIRST=false

# JPA / Hibernate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_HIBERNATE_DDL_AUTO=validate

# JWT Security (Load via KMS / Secrets Manager in Prod)
JWT_SECRET=your-production-high-entropy-jwt-secret-min-512-bits-long
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS (Strict production domain whitelist)
CORS_ALLOWED_ORIGINS=https://support.company.com

# AI Service (Production Internal Load Balancer / VPC)
AI_SERVICE_URL=http://ai-service.prod.internal:8000
AI_GENERATE_PATH=/api/v1/ai/generate
LLM_TIMEOUT=30s

# Swagger / OpenAPI (Disabled in production for security)
SWAGGER_ENABLED=false
SWAGGER_TITLE=Customer Support Platform API
SWAGGER_DESCRIPTION=RESTful API documentation for Customer Support Platform
SWAGGER_VERSION=1.0.0
